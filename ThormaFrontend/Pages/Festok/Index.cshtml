@page
@model ThormaFrontend.Pages.Festok.IndexModel
@using ThormaFrontend.Services
@inject AuthSession AuthSession

<h1>Festők</h1>
@if (AuthSession.IsInRole("Admin"))
{
    <p>
        <a asp-page="./Create" class="btn btn-success mb-3">Új festő</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>Azonosító</th>
            <th>Név</th>
            <th>Született</th>
            <th>Meghalt</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Festok)
        {
            <tr>
                <td>@f.Azon</td>
                <td>@f.Nev</td>
                <td>@f.Szuletett</td>
                <td>@f.Meghalt</td>
                <td>
                    @if (AuthSession.IsInRole("User") || AuthSession.IsInRole("Admin"))
                    {
                        <a asp-page="./Details" asp-route-azon="@f.Azon" class="btn btn-sm btn-outline-primary">Details</a>
                    }
                    @if (AuthSession.IsInRole("Admin"))
                    {
                        <span> | </span>
                        <a asp-page="./Edit" asp-route-azon="@f.Azon" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <span> | </span>
                        <a asp-page="./Delete" asp-route-azon="@f.Azon" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
