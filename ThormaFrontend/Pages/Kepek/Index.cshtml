@page
@model ThormaFrontend.Pages.Kepek.IndexModel
@using ThormaFrontend.Services
@inject AuthSession AuthSession

<h1>Képek</h1>

@if (AuthSession.IsSignedIn && AuthSession.IsInRole("Admin"))
{
    <p>
        <a asp-page="./Create" class="btn btn-success mb-3">Új kép</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>Leltár</th>
            <th>Festő</th>
            <th>Cím</th>
            <th>Készült</th>
            <th>Széles</th>
            <th>Magas</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var k in Model.Kepek)
        {
            <tr>
                <td>@k.Leltar</td>
                <td>@k.FestoNev</td>
                <td>@k.Cim</td>
                <td>@k.Keszult</td>
                <td>@k.Szeles</td>
                <td>@k.Magas</td>
                <td>
                    @if (AuthSession.IsInRole("User") || AuthSession.IsInRole("Admin"))
                    {
                        <a asp-page="./Details" asp-route-leltar="@k.Leltar" class="btn btn-sm btn-outline-primary">Details</a>
                    }
                    @if (AuthSession.IsInRole("Admin"))
                    {
                        <span> | </span>
                        <a asp-page="./Edit" asp-route-leltar="@k.Leltar" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <span> | </span>
                        <a asp-page="./Delete" asp-route-leltar="@k.Leltar" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
