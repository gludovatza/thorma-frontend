@page
@model ThormaFrontend.Pages.Admin.UserDetailsModel
@{
    ViewData["Title"] = "Felhasználó részletei";
}

<div class="container mt-4">
    <h1 class="mb-4">
        <i class="bi bi-person-circle"></i> Felhasználó részletei
    </h1>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Admin/Index">Admin</a></li>
            <li class="breadcrumb-item"><a asp-page="/Admin/Users">Felhasználók</a></li>
            <li class="breadcrumb-item active" aria-current="page">Részletek</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.UserDetails != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Felhasználói információk</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Felhasználó ID:</dt>
                    <dd class="col-sm-9">@Model.UserDetails.User.UserId</dd>

                    <dt class="col-sm-3">E-mail cím:</dt>
                    <dd class="col-sm-9">@Model.UserDetails.User.Email</dd>

                    <dt class="col-sm-3">Felhasználónév:</dt>
                    <dd class="col-sm-9">@Model.UserDetails.User.UserName</dd>

                    <dt class="col-sm-3">Szerepkörök:</dt>
                    <dd class="col-sm-9">
                        @foreach (var role in Model.UserDetails.User.Roles)
                        {
                            <span class="badge @(role == "Admin" ? "bg-danger" : "bg-warning") me-1">@role</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="text-muted">Összes művelet</h6>
                        <h2 class="mb-0">@Model.UserDetails.Stats.TotalActions</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="text-muted">Sikertelen belépések</h6>
                        <h2 class="mb-0 @(Model.UserDetails.Stats.FailedLogins > 0 ? "text-danger" : "")">
                            @Model.UserDetails.Stats.FailedLogins
                        </h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="text-muted">Utolsó aktivitás</h6>
                        <p class="mb-0">
                            @if (Model.UserDetails.Stats.LastActivity.HasValue)
                            {
                                @Model.UserDetails.Stats.LastActivity.Value.ToString("yyyy-MM-dd HH:mm:ss")
                            }
                            else
                            {
                                <span class="text-muted">Nincs adat</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Utolsó 100 log bejegyzés</h5>
            </div>
            <div class="card-body">
                @if (Model.UserDetails.RecentLogs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Időpont</th>
                                    <th>Metódus</th>
                                    <th>Útvonal</th>
                                    <th>Státusz</th>
                                    <th>Entitás</th>
                                    <th>Művelet</th>
                                    <th>IP cím</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.UserDetails.RecentLogs)
                                {
                                    <tr class="@(log.IsAuthFailure ? "table-danger" : "")">
                                        <td class="text-nowrap">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>
                                            <span class="badge bg-secondary">@log.HttpMethod</span>
                                        </td>
                                        <td><small>@log.Path</small></td>
                                        <td>
                                            <span class="badge @(log.StatusCode >= 200 && log.StatusCode < 300 ? "bg-success" : log.StatusCode >= 400 ? "bg-danger" : "bg-warning")">
                                                @log.StatusCode
                                            </span>
                                        </td>
                                        <td>@(log.EntityType ?? "-")</td>
                                        <td>@(log.Action ?? "-")</td>
                                        <td><small>@(log.IpAddress ?? "-")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">Nincs elérhető log bejegyzés.</p>
                }
            </div>
        </div>
    }
</div>
